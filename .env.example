# Server
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/attest
NODE_ENV=development

# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=demo-store.myshopify.com

# Attest API (for Shopify app and consent portal)
ATTEST_API_URL=http://localhost:3000

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CLIENT_ID=ca_...

# Email (set EMAIL_PROVIDER=resend for production)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Attest <noreply@attest.dev>

# Consent Portal
CONSENT_PORTAL_URL=http://localhost:3001

# MCP Adapter
ATTEST_ISSUER=anthropic
ATTEST_PRIVATE_KEY=
ATTEST_KID=
