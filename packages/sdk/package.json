{
  "name": "@anthropic-attest/sdk",
  "version": "0.1.0",
  "description": "Agent attestation SDK — create and verify identity tokens for agent-to-merchant commerce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djt53/attest",
    "directory": "packages/sdk"
  },
  "keywords": ["agent", "attestation", "identity", "commerce", "jwt", "verification"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    },
    "./challenge": {
      "import": "./dist/challenge.js",
      "types": "./dist/challenge.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./adapters/openai": {
      "import": "./dist/adapters/openai.js",
      "types": "./dist/adapters/openai.d.ts"
    },
    "./adapters/generic-jwt": {
      "import": "./dist/adapters/generic-jwt.js",
      "types": "./dist/adapters/generic-jwt.d.ts"
    },
    "./adapters/stripe": {
      "import": "./dist/adapters/stripe.js",
      "types": "./dist/adapters/stripe.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  }
}
